// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma schema for Unshackled

model User {
  id                String    @id @default(uuid()) @db.Uuid
  firstName         String
  lastName          String
  email             String    @unique
  password          String
  userName          String?   @unique @default(cuid())
  bio               String?
  photoURL          String?
  location          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt
  isProfileComplete Boolean   @default(false)
  followerCount     Int       @default(0)
  followeeCount     Int       @default(0)
  newsCount         Int       @default(0)

  //? Relations
  newsPosted        News[]
  bookmarkedNews    News[]    @relation("UserBookmarkedNews")
  upvotedNews       News[]    @relation("UserUpvotedNews")
  downvotedNews     News[]    @relation("UserDownvotedNews")
  upvotedComments   Comment[] @relation("UserUpvotedComments")
  downvotedComments Comment[] @relation("UserDownvotedComments")
  followers         Follow[]  @relation("UserFollowers")
  followees         Follow[]  @relation("UserFollowees")
  collaboratorNews  News[]    @relation("CollaboratorNews")
  comments          Comment[]

  analytics Json?
}

model News {
  id                  String   @id @default(cuid()) // Unique identifier
  title               String
  content             String
  posterImage         String?
  flare               String
  is_Author_Anonymous Boolean  @default(false)
  postingTime         DateTime @default(now())
  upvotes             Int      @default(0)
  downvotes           Int      @default(0)
  bookmarkCount       Int      @default(0)

  //? Relations
  comments      Comment[]
  author        User      @relation(fields: [authorId], references: [id])
  authorId      String    @db.Uuid
  collaborators User[]    @relation("CollaboratorNews")
  bookmarkedBy  User[]    @relation("UserBookmarkedNews")
  upvotedBy     User[]    @relation("UserUpvotedNews")
  downvotedBy   User[]    @relation("UserDownvotedNews")
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  timePosted DateTime @default(now())

  //? Relations
  news     News   @relation(fields: [newsId], references: [id])
  newsId   String
  author   User   @relation(fields: [authorId], references: [id])
  authorId String @db.Uuid

  //? Nested replies
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String?
  replies     Comment[] @relation("CommentReplies")
  upvotedBy   User[]    @relation("UserUpvotedComments")
  downvotedBy User[]    @relation("UserDownvotedComments")
}

model Follow {
  id         String @id @default(cuid())
  followerId String @db.Uuid
  followeeId String @db.Uuid

  //? Relations
  follower User @relation("UserFollowees", fields: [followerId], references: [id])
  followee User @relation("UserFollowers", fields: [followeeId], references: [id])

  createdAt DateTime @default(now())
}
