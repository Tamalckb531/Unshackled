{
  "name": "@tamaldip/common",
  "version": "1.0.21",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bump": "standard-version",
    "publish_code": "npm run build && npm publish",
    "update": "npm run bump && npm run publish_code && concurrently \"npm run update-frontend\" \"npm run update-backend\"",
    "update-frontend": "cd ../frontend && npm install @tamaldip/common",
    "update-backend": "cd ../backend && npm install @tamaldip/common"
  },
